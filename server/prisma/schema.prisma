// Response Hub — PostgreSQL + PostGIS schema.
//
// Enum values are stored in SCREAMING_SNAKE_CASE and mapped to the display
// labels the frontend uses (src/types/incident.ts) in src/domain/enums.ts.
//
// Spatial data: `latitude`/`longitude` are the writable source of truth.
// `location` is a geography(Point, 4326) column kept in sync by a database
// trigger (see migration 20261110000100_postgis_location) and indexed with
// GiST for ST_DWithin radius queries and clustering.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum Role {
  CITIZEN
  DISPATCHER
  RESPONDER
  ADMIN
}

enum IncidentCategory {
  FIRE
  ROAD_ACCIDENT
  MEDICAL_EMERGENCY
  FLOOD
  BUILDING_COLLAPSE
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  REPORTED
  PENDING
  IN_PROGRESS
  RESOLVED
}

enum Verification {
  UNVERIFIED
  UNDER_REVIEW
  VERIFIED
}

enum SafetyAnswer {
  YES
  NO
  UNKNOWN
}

enum ActivityType {
  SUBMITTED
  SEVERITY_SUGGESTED
  SEVERITY_CHANGED
  VERIFICATION_CHANGED
  STATUS_CHANGED
  ASSIGNED
  NOTE
}

enum ActorType {
  REPORTER
  SYSTEM
  STAFF
}

enum MediaType {
  IMAGE
  VIDEO
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  passwordHash String
  role         Role
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedIncidents Incident[]       @relation("IncidentAssignee")
  activities        IncidentUpdate[]
}

model Incident {
  id              String           @id @default(uuid()) @db.Uuid
  /// Public tracking code, e.g. RH-2026-7K3QX9MD. Unguessable; shown to the reporter.
  trackingCode    String           @unique
  /// Client-generated Idempotency-Key so retried submissions don't duplicate reports.
  clientRequestId String?          @unique
  title           String           @db.VarChar(160)
  description     String           @db.VarChar(5000)
  category        IncidentCategory
  locationText    String           @db.VarChar(300)

  latitude  Float?
  longitude Float?
  location  Unsupported("geography(Point, 4326)")?

  peopleAffected Int @default(0)

  /// Reporter contact. Null when the report is anonymous.
  isAnonymous    Boolean @default(true)
  contactName    String? @db.VarChar(120)
  contactDetails String? @db.VarChar(200)

  immediateThreat SafetyAnswer
  peopleTrapped   SafetyAnswer
  ongoingHazard   SafetyAnswer

  suggestedSeverity Severity
  currentSeverity   Severity
  severityReason    String
  requiresReview    Boolean        @default(true)
  status            IncidentStatus @default(REPORTED)
  verification      Verification   @default(UNVERIFIED)

  assigneeId String? @db.Uuid
  assignee   User?   @relation("IncidentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// Lifecycle timestamps used for response-time analytics.
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  deletedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media    IncidentMedia[]
  activity IncidentUpdate[]

  @@index([status, currentSeverity])
  @@index([category])
  @@index([createdAt(sort: Desc)])
  @@index([assigneeId])
  @@index([location], type: Gist)
}

model IncidentMedia {
  id          String    @id @default(uuid()) @db.Uuid
  incidentId  String    @db.Uuid
  incident    Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  /// Object key in the bucket, e.g. uploads/2026/11/<uuid>.jpg
  storageKey  String    @unique
  type        MediaType
  contentType String
  sizeBytes   Int?
  uploadedAt  DateTime  @default(now())

  @@index([incidentId])
}

/// Timeline / audit log. Append-only: rows are never updated or deleted by the API.
model IncidentUpdate {
  id         String       @id @default(uuid()) @db.Uuid
  incidentId String       @db.Uuid
  incident   Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type       ActivityType
  message    String       @db.VarChar(2000)
  actorType  ActorType
  actorId    String?      @db.Uuid
  actor      User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Whether the entry is shown on the public tracking page. Staff notes default to private.
  isPublic   Boolean      @default(true)
  /// Structured before/after values for auditing, e.g. { "from": "PENDING", "to": "IN_PROGRESS" }.
  metadata   Json?
  createdAt  DateTime     @default(now())

  @@index([incidentId, createdAt])
}
