// Response Hub — PostgreSQL + PostGIS schema.
//
// Enum values are stored in SCREAMING_SNAKE_CASE and mapped to the display
// labels the frontend uses (src/types/incident.ts) in src/domain/enums.ts.
//
// Spatial data: `latitude`/`longitude` are the writable source of truth.
// `location` is a geography(Point, 4326) column kept in sync by a database
// trigger (see migration 20261110000100_postgis_location) and indexed with
// GiST for ST_DWithin radius queries and clustering.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum Role {
  CITIZEN
  DISPATCHER
  RESPONDER
  ADMIN
}

enum IncidentCategory {
  FIRE
  ROAD_ACCIDENT
  MEDICAL_EMERGENCY
  FLOOD
  BUILDING_COLLAPSE
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Reported → (Pending review) → Assigned → In Progress → Resolved
enum IncidentStatus {
  REPORTED
  PENDING
  ASSIGNED
  IN_PROGRESS
  RESOLVED
}

/// Automatic priority from the transparent weighted score (src/domain/priority.ts).
enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TeamCategory {
  FIRE
  MEDICAL
  RESCUE
  POLICE
  DISASTER_RELIEF
}

enum TeamAvailability {
  AVAILABLE
  BUSY
}

enum AssignmentMethod {
  RECOMMENDED
  MANUAL
}

enum ReleaseReason {
  RESOLVED
  REASSIGNED
  UNASSIGNED
  INCIDENT_DELETED
}

enum RouteSource {
  OSRM
  STRAIGHT_LINE
}

enum Verification {
  UNVERIFIED
  UNDER_REVIEW
  VERIFIED
}

enum SafetyAnswer {
  YES
  NO
  UNKNOWN
}

enum ActivityType {
  SUBMITTED
  SEVERITY_SUGGESTED
  SEVERITY_CHANGED
  VERIFICATION_CHANGED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNED
  TEAM_RELEASED
  NOTE
}

enum ActorType {
  REPORTER
  SYSTEM
  STAFF
}

enum MediaType {
  IMAGE
  VIDEO
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  passwordHash String
  role         Role
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedIncidents Incident[]       @relation("IncidentAssignee")
  activities        IncidentUpdate[]
  teamAssignments   TeamAssignment[]
  statusChanges     IncidentStatusChange[]
}

model Incident {
  id              String           @id @default(uuid()) @db.Uuid
  /// Public tracking code, e.g. RH-2026-7K3QX9MD. Unguessable; shown to the reporter.
  trackingCode    String           @unique
  /// Client-generated Idempotency-Key so retried submissions don't duplicate reports.
  clientRequestId String?          @unique
  title           String           @db.VarChar(160)
  description     String           @db.VarChar(5000)
  category        IncidentCategory
  locationText    String           @db.VarChar(300)

  latitude  Float?
  longitude Float?
  location  Unsupported("geography(Point, 4326)")?

  peopleAffected Int @default(0)

  /// Reporter contact. Null when the report is anonymous.
  isAnonymous    Boolean @default(true)
  contactName    String? @db.VarChar(120)
  contactDetails String? @db.VarChar(200)

  immediateThreat SafetyAnswer
  peopleTrapped   SafetyAnswer
  ongoingHazard   SafetyAnswer

  suggestedSeverity Severity
  currentSeverity   Severity
  severityReason    String
  requiresReview    Boolean        @default(true)
  status            IncidentStatus @default(REPORTED)
  verification      Verification   @default(UNVERIFIED)

  assigneeId String? @db.Uuid
  assignee   User?   @relation("IncidentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// Lifecycle timestamps used for response-time analytics.
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  assignedAt      DateTime?

  /// Automatic prioritization, recalculated on every change and by the escalation job.
  priority          Priority  @default(LOW)
  priorityScore     Int       @default(0)
  /// [{ key, label, points, max, detail }] — explains the score.
  priorityFactors   Json?
  priorityUpdatedAt DateTime?

  /// Team currently responding. @unique: a team can hold at most one incident.
  assignedTeamId String?        @unique @db.Uuid
  assignedTeam   ResponseTeam?  @relation("ActiveIncident", fields: [assignedTeamId], references: [id], onDelete: Restrict)
  deletedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media    IncidentMedia[]
  activity      IncidentUpdate[]
  assignments   TeamAssignment[]
  statusChanges IncidentStatusChange[]

  @@index([status, currentSeverity])
  @@index([category])
  @@index([createdAt(sort: Desc)])
  @@index([assigneeId])
  @@index([location], type: Gist)
  @@index([priority, status])
}

model ResponseTeam {
  id           String           @id @default(uuid()) @db.Uuid
  /// Human-readable ID, e.g. TEAM-004.
  code         String           @unique
  name         String           @unique @db.VarChar(80)
  category     TeamCategory
  latitude     Float
  longitude    Float
  /// Derived from latitude/longitude by trigger (see migration 20261110000200_response_teams).
  location     Unsupported("geography(Point, 4326)")?
  availability TeamAvailability @default(AVAILABLE)
  contactName  String           @db.VarChar(120)
  contactPhone String           @db.VarChar(30)
  contactEmail String?          @db.VarChar(200)
  /// Soft delete keeps assignment history intact.
  deletedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  activeIncident Incident?        @relation("ActiveIncident")
  assignments    TeamAssignment[]

  @@index([category, availability])
  @@index([location], type: Gist)
}

/// Every team ↔ incident assignment, kept as history. At most one open
/// (releasedAt IS NULL) row per team and per incident — enforced by partial
/// unique indexes in the migration.
model TeamAssignment {
  id               String           @id @default(uuid()) @db.Uuid
  incidentId       String           @db.Uuid
  incident         Incident         @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  teamId           String           @db.Uuid
  team             ResponseTeam     @relation(fields: [teamId], references: [id], onDelete: Restrict)
  method           AssignmentMethod
  assignedById     String?          @db.Uuid
  assignedBy       User?            @relation(fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt       DateTime         @default(now())
  /// Haversine distance at assignment time.
  straightLineKm   Float?
  routeSource      RouteSource?
  routeDistanceKm  Float?
  routeDurationMin Float?
  releasedAt       DateTime?
  releaseReason    ReleaseReason?

  @@index([incidentId, assignedAt])
  @@index([teamId, assignedAt])
}

/// Explicit status timeline (Reported → Assigned → In Progress → Resolved).
model IncidentStatusChange {
  id         String          @id @default(uuid()) @db.Uuid
  incidentId String          @db.Uuid
  incident   Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  fromStatus IncidentStatus?
  toStatus   IncidentStatus
  actorId    String?         @db.Uuid
  actor      User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  changedAt  DateTime        @default(now())

  @@index([incidentId, changedAt])
}

model IncidentMedia {
  id          String    @id @default(uuid()) @db.Uuid
  incidentId  String    @db.Uuid
  incident    Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  /// Object key in the bucket, e.g. uploads/2026/11/<uuid>.jpg
  storageKey  String    @unique
  type        MediaType
  contentType String
  sizeBytes   Int?
  uploadedAt  DateTime  @default(now())

  @@index([incidentId])
}

/// Timeline / audit log. Append-only: rows are never updated or deleted by the API.
model IncidentUpdate {
  id         String       @id @default(uuid()) @db.Uuid
  incidentId String       @db.Uuid
  incident   Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type       ActivityType
  message    String       @db.VarChar(2000)
  actorType  ActorType
  actorId    String?      @db.Uuid
  actor      User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Whether the entry is shown on the public tracking page. Staff notes default to private.
  isPublic   Boolean      @default(true)
  /// Structured before/after values for auditing, e.g. { "from": "PENDING", "to": "IN_PROGRESS" }.
  metadata   Json?
  createdAt  DateTime     @default(now())

  @@index([incidentId, createdAt])
}
