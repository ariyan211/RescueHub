# ---------- Server ----------
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (the Vite app).
CORS_ORIGINS=http://localhost:5173,http://localhost:8443
# Set to the number of reverse proxies in front of the API (for correct client IPs in rate limiting).
TRUST_PROXY=0
LOG_LEVEL=info

# ---------- Database (PostgreSQL 14+ with PostGIS 3) ----------
DATABASE_URL=postgresql://responsehub:responsehub@localhost:5432/responsehub?schema=public

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h
JWT_ISSUER=responsehub-api

# First admin account, created by `npm run db:seed` if it does not exist.
SEED_ADMIN_EMAIL=admin@responsehub.local
SEED_ADMIN_PASSWORD=change-me-please
SEED_ADMIN_NAME=Response Hub Admin
# Set to true to also insert the fictional demo incidents from the frontend.
SEED_DEMO_INCIDENTS=true

# ---------- Object storage (S3 / Cloudflare R2 / Supabase Storage / MinIO) ----------
S3_BUCKET=responsehub-media
S3_REGION=auto
# Leave empty for AWS S3. R2: https://<account-id>.r2.cloudflarestorage.com
# Supabase: https://<project-ref>.supabase.co/storage/v1/s3   MinIO (docker-compose): http://localhost:9000
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Optional: public CDN base for media (e.g. R2 custom domain). If empty, the API returns short-lived signed GET URLs.
MEDIA_PUBLIC_BASE_URL=
UPLOAD_MAX_BYTES=10485760
UPLOAD_URL_TTL_SECONDS=300
